// 7. MPU6050 GYRO MODULE
// ============================================================================
float gzOffset = 0.0f;
float gyOffset = 0.0f;

void initMPU6050() {
  Wire.begin(I2C_SDA_PIN, I2C_SCL_PIN);

  Wire.beginTransmission(MPU6050_ADDR);
  Wire.write(0x6B);
  Wire.write(0x00);
  Wire.endTransmission(true);
  delay(100);

  long sumGz = 0;
  long sumGy = 0;
  for (int i = 0; i < 200; i++) {
    Wire.beginTransmission(MPU6050_ADDR);
    Wire.write(0x45);
    Wire.endTransmission(false);
    Wire.requestFrom((uint8_t)MPU6050_ADDR, (uint8_t)4, (bool)true);
    int16_t rawGy = (Wire.read() << 8) | Wire.read();
    int16_t rawGz = (Wire.read() << 8) | Wire.read();
    sumGy += rawGy;
    sumGz += rawGz;
    delay(2);
  }
  gzOffset = sumGz / 200.0f;
  gyOffset = sumGy / 200.0f;

  #if DEBUG
    Serial.print("[MPU6050] Gyro Y offset (pitch): "); Serial.println(gyOffset);
    Serial.print("[MPU6050] Gyro Z offset (yaw):   "); Serial.println(gzOffset);
  #endif
}

void updateGyroCache() {
  unsigned long now = millis();
  if (now - lastGyroRead < GYRO_READ_INTERVAL) return;
  lastGyroRead = now;

  Wire.beginTransmission(MPU6050_ADDR);
  Wire.write(0x45);
  Wire.endTransmission(false);
  if (Wire.requestFrom((uint8_t)MPU6050_ADDR, (uint8_t)4, (bool)true) != 4) {
    // FIX #4 — don't zero the filtered values on a single bad read
    return;
  }
  int16_t rawGy = (Wire.read() << 8) | Wire.read();
  int16_t rawGz = (Wire.read() << 8) | Wire.read();

  float rawPitch = (rawGy - gyOffset) / 131.0f;
  float rawYaw   = (rawGz - gzOffset) / 131.0f;

  // FIX #4 — first-order IIR low-pass on both axes
  gyroPitchRate = GYRO_LPF_ALPHA * gyroPitchRate + (1.0f - GYRO_LPF_ALPHA) * rawPitch;
  gyroYawRate   = GYRO_LPF_ALPHA * gyroYawRate   + (1.0f - GYRO_LPF_ALPHA) * rawYaw;
}

float getYawRate()   { return gyroYawRate;   }
float getPitchRate() { return gyroPitchRate; }

// ============================================================================
// 8. GPS / NAVIGATION MODULE
// ============================================================================
void processGPS() {
  int limit = 0;
  while (gpsSerial.available() > 0 && limit < 64) {
    gps.encode(gpsSerial.read());
    limit++;
  }
  if (gps.location.isValid() && !homeSet) {
    homeLat = gps.location.lat();
    homeLon = gps.location.lng();
    homeSet = true;
    Serial.println("[GPS] Home position locked.");
  }
}

void navigateHome() {
  if (!homeSet || !gps.location.isValid()) {
    targetThrottle = 0;
    return;
  }
  double dist = gps.distanceBetween(gps.location.lat(), gps.location.lng(), homeLat, homeLon);
  if (dist > 2.0) {
    double course = gps.courseTo(gps.location.lat(), gps.location.lng(), homeLat, homeLon);
    int center = 90 + steerTrim;
    double headingDeg = gps.course.deg();
    double error = course - headingDeg;

    if (error > 180)  error -= 360;
    if (error < -180) error += 360;

    // FIX #9 — named constant for heading gain
    targetSteer    = constrain(center + error * NAV_HEADING_GAIN,
                               center - steerSens, center + steerSens);
    targetThrottle = 150;
  } else {
    targetThrottle = 0;
    isReturningHome = false;
  }
}

// ============================================================================
// 9a. STEERING MODULE
// ============================================================================
int processTiltSteering(int ax) {
  float tilt = ax / 512.0f;

  if (abs(tilt) < TILT_DEADZONE) tilt = 0;

  if (tilt > 0)       tilt = (tilt - TILT_DEADZONE) / (1.0f - TILT_DEADZONE);
  else if (tilt < 0)  tilt = (tilt + TILT_DEADZONE) / (1.0f - TILT_DEADZONE);

  tilt *= steeringSensitivity;
  tilt = constrain(tilt, -1.0f, 1.0f);

  // FIX #7 — explicit rounding, no silent int truncation
  float out = (float)steerCenter() + tilt * (float)steerSens;
  return (int)lroundf(out);
}

float computeSteerFromStick(int rawStick) {
  if (abs(rawStick) < STICK_DEADZONE) rawStick = 0;

  float norm = rawStick / 512.0f;
  float expoOut = (1.0f - STEER_EXPO) * norm + STEER_EXPO * norm * norm * norm;

  float offset = expoOut * steerSens * steeringSensitivity;

  float gyroCorrection = 0.0f;
  if (gyroEnabled) gyroCorrection = getYawRate() * gyroGain;

  float target = (float)steerCenter() + offset - gyroCorrection;
  return constrain(target, (float)SERVO_MIN, (float)SERVO_MAX);
}

// ============================================================================
// 9b. GYRO FLIP DETECTOR
// ============================================================================
void updateFlipDetector(unsigned long now) {
  // Reset candidate counters whenever we bail out early
  if (!flipAssistEnabled || currentMode != MODE_BEAST) {
    flipBackCandidateCount  = 0;
    flipFrontCandidateCount = 0;
    if (flipState != FLIP_NONE) {
      flipState = FLIP_NONE;
      BackFlip  = false;
      FrontFlip = false;
    }
    return;
  }

  if (now - lastFlipEndTime < FLIP_COOLDOWN) {
    flipBackCandidateCount  = 0;
    flipFrontCandidateCount = 0;
    BackFlip  = false;
    FrontFlip = false;
    return;
  }

  float pitchRate = getPitchRate() * FLIP_PITCH_SIGN;

  if (flipState == FLIP_NONE) {
    // FIX #3 — two consecutive samples required to trigger
    if (pitchRate > FLIP_TRIGGER_RATE) {
      flipBackCandidateCount++;
      flipFrontCandidateCount = 0;
      if (flipBackCandidateCount >= FLIP_CONFIRM_SAMPLES) {
        flipState     = FLIP_BACK;
        flipStartTime = now;
        flipBackCandidateCount = 0;
        Serial.printf("[FLIP] Backflip started (%.0f dps)\n", pitchRate);
      }
    } else if (pitchRate < -FLIP_TRIGGER_RATE) {
      flipFrontCandidateCount++;
      flipBackCandidateCount = 0;
      if (flipFrontCandidateCount >= FLIP_CONFIRM_SAMPLES) {
        flipState     = FLIP_FRONT;
        flipStartTime = now;
        flipFrontCandidateCount = 0;
        Serial.printf("[FLIP] Frontflip started (%.0f dps)\n", pitchRate);
      }
    } else {
      // Below trigger threshold — reset both counters
      flipBackCandidateCount  = 0;
      flipFrontCandidateCount = 0;
    }
  } else {
    unsigned long elapsed = now - flipStartTime;
    bool released = false;

    if (flipState == FLIP_BACK  && pitchRate <  FLIP_RELEASE_RATE) released = true;
    if (flipState == FLIP_FRONT && pitchRate > -FLIP_RELEASE_RATE) released = true;

    bool timedOut = (elapsed > FLIP_MAX_HOLD);
    bool done     = timedOut || (elapsed > FLIP_MIN_HOLD && released);

    if (done) {
      Serial.printf("[FLIP] Ended after %lu ms\n", elapsed);
      flipState        = FLIP_NONE;
      lastFlipEndTime  = now;
    }
  }

  BackFlip  = (flipState == FLIP_BACK);
  FrontFlip = (flipState == FLIP_FRONT);
}

// ============================================================================
// 10. GAMEPAD MODULE
// ============================================================================
void onConnectedGamepad(GamepadPtr gp) {
  Serial.println("[BP32] Gamepad connected.");
  myGamepad = gp;
  gamepadEverConnected = true;   // FIX #1
}

void onDisconnectedGamepad(GamepadPtr gp) {
  Serial.println("[BP32] Gamepad disconnected.");
  myGamepad = nullptr;
}

void updateGamepadLed(unsigned long now) {
  if (!myGamepad) return;

  if (lowBattFlashActive) {
    if (now - lastFlashTime >= (unsigned long)FLASH_INTERVAL) {
      if (flashCount % 2 == 0) myGamepad->setColorLED(255, 0, 0);
      else                     myGamepad->setColorLED(0, 0, 0);
      flashCount++;
      lastFlashTime = now;
    }
    return;
  }

  if (currentMode != lastLedMode) {
    if (currentMode == MODE_BEAST) myGamepad->setColorLED(255, 0, 0);
    else                          myGamepad->setColorLED(0, 255, 0);
    lastLedMode = currentMode;
  }
}

void checkPsShutdown(ControllerPtr gp) {
  bool psPressed = (gp->miscButtons() & 0x01);
  static uint32_t psPressStart = 0;
  static bool     wasPressed   = false;

  if (psPressed) {
    if (!wasPressed) {
      psPressStart = millis();
      wasPressed = true;
      Serial.println("[PS] Button pressed. Hold 5s to shut down...");
    } else if (millis() - psPressStart >= PS_SHUTDOWN_HOLD) {
      Serial.println("[PS] Soft shutdown initiated.");
      gp->setPlayerLEDs(0);
      gp->playDualRumble(0, 0, 0, 0);
      gp->disconnect();
      wasPressed = false;
    }
  } else {
    wasPressed = false;
  }
}

void processGamepad(ControllerPtr gp, unsigned long now) {

  checkPsShutdown(gp);

  updateFlipDetector(now);

  // ---- R1 double-tap: toggle drive mode
  if (gp->r1() && !r1Last) {
    if (now - lastR1Press < 300) {
      currentMode = (currentMode == MODE_BEAST) ? MODE_PRECISION : MODE_BEAST;
      digitalWrite(MODE_LED, currentMode == MODE_BEAST);
      Serial.print("[MODE] "); Serial.println(currentMode == MODE_BEAST ? "BEAST" : "PRECISION");
    }
    lastR1Press = now;
  }
  r1Last = gp->r1();

  // ---- L1 tap: tilt steering toggle
  if (gp->l1() && !l1Last) {
    tiltMode = !tiltMode;
    Serial.print("[STEER] Tilt mode: "); Serial.println(tiltMode);
  }
  l1Last = gp->l1();

  // ---- Y tap: roof lights
  if (gp->y() && !yLast) {
    roofState = !roofState;
    digitalWrite(ROOF_PIN, roofState);
    Serial.print("[LIGHT] Roof: "); Serial.println(roofState);
  }
  yLast = gp->y();

  // ---- X tap/hold: halo (tap) / boost (hold)
  bool xNow = gp->x();
  if (xNow && !xLast) xPressTime = now;
  if (xNow && (now - xPressTime > (unsigned long)HOLD_TIME)) boostActive = true;
  if (!xNow && xLast) {
    if (now - xPressTime < (unsigned long)TAP_TIME) {
      haloState = !haloState;
      digitalWrite(HALO_PIN, haloState);
      Serial.print("[LIGHT] Halo: "); Serial.println(haloState);
    }
    boostActive = false;
  }
  xLast = xNow;

  // ---- D-pad: sensitivity (UP/DOWN) + response (RIGHT/LEFT)
  uint8_t dpad = gp->dpad();
  if (dpad != lastDpad) {

    if (dpad == DPAD_UP) {
      steeringSensitivity = min(MAX_SENSITIVITY, steeringSensitivity + 0.1f);
      Serial.printf("[STEER] sens=%.2f  response=%.2f  (tilt=%d)\n",
                    steeringSensitivity, steerLerp, tiltMode);
    }
    if (dpad == DPAD_DOWN) {
      steeringSensitivity = max(MIN_SENSITIVITY, steeringSensitivity - 0.1f);
      Serial.printf("[STEER] sens=%.2f  response=%.2f  (tilt=%d)\n",
                    steeringSensitivity, steerLerp, tiltMode);
    }
    if (dpad == DPAD_RIGHT) {
      steerLerp = min(STEER_LERP_MAX, steerLerp + 0.05f);
      Serial.printf("[STEER] response=%.2f\n", steerLerp);
    }
    if (dpad == DPAD_LEFT) {
      steerLerp = max(STEER_LERP_MIN, steerLerp - 0.05f);
      Serial.printf("[STEER] response=%.2f\n", steerLerp);
    }

    lastDpad = dpad;
  }

  // ---- Options tap: gyro yaw-assist toggle  (FIX #8 — debounced)
  bool optionsNow = (gp->miscButtons() & 0x04);
  if (optionsNow && !optionsLast && (now - lastOptionsToggle > TOGGLE_DEBOUNCE_MS)) {
    gyroEnabled = !gyroEnabled;
    lastOptionsToggle = now;
    Serial.print("[GYRO] Yaw assist: "); Serial.println(gyroEnabled ? "ON" : "OFF");
  }
  optionsLast = optionsNow;

  // ---- B tap: gyro flip-assist toggle  (FIX #8 — debounced)
  bool bNow = gp->b();
  if (bNow && !bLast && (now - lastBToggle > TOGGLE_DEBOUNCE_MS)) {
    flipAssistEnabled = !flipAssistEnabled;
    lastBToggle = now;
    Serial.print("[FLIP] Assist: "); Serial.println(flipAssistEnabled ? "ON" : "OFF");
    if (!flipAssistEnabled) {
      flipState = FLIP_NONE;
      BackFlip  = false;
      FrontFlip = false;
      flipBackCandidateCount  = 0;
      flipFrontCandidateCount = 0;
    }
  }
  bLast = bNow;

  // ========================================================================
  //  STEERING PIPELINE
  // ========================================================================
  if (tiltMode) {
    int ax = gp->accelX();
    targetSteer = processTiltSteering(ax);

    if (gyroEnabled) targetSteer -= getYawRate() * gyroGain;
    targetSteer = constrain(targetSteer, (float)SERVO_MIN, (float)SERVO_MAX);

  } else {
    int sx = gp->axisX();
    if (abs(sx) > STICK_DEADZONE) {
      targetSteer = computeSteerFromStick(sx);
    } else {
      float gyroCorrection = gyroEnabled ? (getYawRate() * gyroGain) : 0.0f;
      targetSteer = steerCenter() - gyroCorrection;
      targetSteer = constrain(targetSteer, (float)SERVO_MIN, (float)SERVO_MAX);
    }
  }

  // ========================================================================
  //  THROTTLE / ESC STATE MACHINE
  // ========================================================================
  int r2 = gp->r2();
  int l2 = gp->l2();
  int throttleInput = 0;

  if (r2 > 100) {
    throttleInput = map(r2, 0, 1023, 0,
                        (currentMode == MODE_BEAST) ? POWER_BEAST_MAX : POWER_PRECISION);
  } else if (l2 > 100) {
    throttleInput = -map(l2, 0, 1023, 0, 250);
  }

  switch (escState) {
    case ESC_NEUTRAL:
      if (throttleInput > 0)       escState = ESC_FORWARD;
      else if (throttleInput < 0)  { escState = ESC_BRAKE; lastBrakeTime = millis(); }
      break;
    case ESC_FORWARD:
      if (throttleInput < 0)       { escState = ESC_BRAKE; lastBrakeTime = millis(); }
      break;
    case ESC_BRAKE:
      if (millis() - lastBrakeTime > (unsigned long)BRAKE_DELAY_MS) {
        if (throttleInput < 0)       escState = ESC_REVERSE;
        else if (throttleInput == 0) escState = ESC_NEUTRAL;
      }
      break;
    case ESC_REVERSE:
      if (throttleInput > 0) escState = ESC_FORWARD;
      break;
  }

  switch (escState) {
    case ESC_FORWARD:  targetThrottle = throttleInput;  break;
    case ESC_BRAKE:    targetThrottle = -250;           break;
    case ESC_REVERSE:  targetThrottle = throttleInput;  break;
    case ESC_NEUTRAL:
    default:           targetThrottle = 0;              break;
  }

  // ========================================================================
  //  MID-AIR CONTROL (Beast mode, right stick vertical)
  // ========================================================================
  int ry = gp->axisRY();

  if (currentMode == MODE_BEAST) {
    bool noOtherInputs =
      abs(gp->axisX()) < 60 && gp->r2() < 20 && gp->l2() < 20 &&
      !gp->a() && !gp->x() && !gp->y() && !gp->l1() && !gp->r1();

    if (abs(ry) > AIR_DEADZONE && noOtherInputs) {
      if (ry > 0) targetThrottle += map(ry,  AIR_DEADZONE,  512, -100, -450);
      else        targetThrottle += map(ry, -512, -AIR_DEADZONE,  600,  200);
      airAdjust = map(ry, -512, 512, -150, 150);
      lastAirAdjustTime = now;   // FIX #5 — keep time reference fresh
    } else {
      // FIX #5 — time-based exponential decay instead of per-loop multiplier
      unsigned long dt_ms = now - lastAirAdjustTime;
      if (dt_ms > 0) {
        float dt = dt_ms / 1000.0f;
        if (dt > 0.1f) dt = 0.1f;  // cap to avoid huge step on first frame
        airAdjust = (int)(airAdjust * expf(-AIR_DECAY_TAU * dt));
        if (abs(airAdjust) < AIR_ADJUST_DEADBAND) airAdjust = 0;
        lastAirAdjustTime = now;
      }
    }
  }

  if (boostActive && targetThrottle < POWER_BOOST) targetThrottle = POWER_BOOST;

  bool aNow = gp->a();
  if (aNow) {
    if (padWheelieTime == 0) padWheelieTime = now;
    unsigned long elapsed = now - padWheelieTime;
    targetThrottle = (elapsed < 250) ? POWER_WHEELIE : POWER_PRECISION;
  } else {
    padWheelieTime = 0;
  }

  if (wheelieState) {
    if      (now - wheelieStartTime < 250)  targetThrottle = 850;
    else if (now - wheelieStartTime < 1000) targetThrottle = 430;
    else                                    wheelieState = false;
  }

  // ========================================================================
  //  FLIP THROTTLE ASSIST  (applied last so it wins)
  // ========================================================================
  if (flipState == FLIP_BACK) {
    int boosted = POWER_BOOST + FLIP_BACK_THROTTLE_ADD;
    if (targetThrottle < boosted) targetThrottle = boosted;
  } else if (flipState == FLIP_FRONT) {
    if (targetThrottle > FLIP_FRONT_BRAKE_ADD) targetThrottle = FLIP_FRONT_BRAKE_ADD;
  }
}

// ============================================================================
// 11. WEB HANDLERS
// ============================================================================
void handleCmd() {
  String c        = server.arg("c");
  String steerArg = server.arg("steer");
  String sens     = server.arg("sens");
  String trim     = server.arg("trim");
  String modeArg  = server.arg("mode");
  String haloArg  = server.arg("halo");
  String roofArg  = server.arg("roof");

  if (modeArg == "toggle") {
    currentMode = (currentMode == MODE_BEAST) ? MODE_PRECISION : MODE_BEAST;
    digitalWrite(MODE_LED, currentMode == MODE_BEAST);
  }

  // FIX #2 — clamp web-supplied values into safe ranges
  if (sens != "") steerSens = constrain(sens.toInt(), STEER_SENS_MIN, STEER_SENS_MAX);
  if (trim != "") steerTrim = constrain(trim.toInt(), STEER_TRIM_MIN, STEER_TRIM_MAX);

  if (haloArg != "") { haloState = haloArg.toInt(); digitalWrite(HALO_PIN, haloState); }
  if (roofArg != "") { roofState = roofArg.toInt(); digitalWrite(ROOF_PIN, roofState); }

  if (steerArg != "") {
    int center = 90 + steerTrim;
    targetSteer = map(steerArg.toInt(), -100, 100, center - steerSens, center + steerSens);
  }

  if (c == "throttle") targetThrottle = (currentMode == MODE_BEAST) ? 600 : 300;
  if (c == "reverse")  targetThrottle = -300;
  if (c == "stop")     { targetThrottle = 0; wheelieState = false; }
  if (c == "boost")    targetThrottle = POWER_BOOST;
  if (c == "wheelie")  { wheelieState = true; wheelieStartTime = millis(); }

  server.send(200, "text/plain", "OK");
}

void handleTelemetry() {
  lastControlTime = millis();

  JsonDocument doc;
  doc["speed"] = (int)currentThrottle;
  doc["mode"]  = (currentMode == MODE_BEAST) ? "BEAST" : "PRECISION";
  doc["batt"]  = (analogRead(BATTERY_PIN) * (3.3f / 4095.0f) * BATTERY_DIVIDER);
  if (gps.location.isValid()) doc["heading"] = gps.course.deg();

  if (homeSet) {
    doc["relX"] = (gps.location.lng() - homeLon) * 100000;
    doc["relY"] = (homeLat - gps.location.lat()) * 100000;
  } else {
    doc["relX"] = 0; doc["relY"] = 0;
  }

  String json;
  serializeJson(doc, json);
  server.send(200, "application/json", json);
}

// ============================================================================
// 12. SETUP / LOOP
// ============================================================================
void setup() {
  Serial.begin(115200);
  Serial.setTimeout(50);          // FIX #6 — cap readStringUntil blocking
  Serial.println("=== TERAXX X-CORE booting ===");

  gpsSerial.begin(9600, SERIAL_8N1, GPS_RX_PIN, GPS_TX_PIN);
  initMPU6050();

  esc.attach(ESC_PIN);
  steeringServo.attach(SERVO_PIN);

  pinMode(HALO_PIN, OUTPUT);
  pinMode(ROOF_PIN, OUTPUT);
  pinMode(BRAKE_LIGHT_PIN, OUTPUT);
  pinMode(MODE_LED, OUTPUT);

  WiFi.disconnect(true);
  WiFi.mode(WIFI_OFF);
  delay(500);
  WiFi.mode(WIFI_AP);
  delay(300);

  IPAddress local_IP(192, 168, 4, 1);
  IPAddress gateway (192, 168, 4, 1);
  IPAddress subnet  (255, 255, 255, 0);
  WiFi.softAPConfig(local_IP, gateway, subnet);

  if (WiFi.softAP("TERAXX_X-CORE", "123456789", 6, 0, 8)) {
    Serial.print("[WiFi] AP up. IP: ");
    Serial.println(WiFi.softAPIP());
  } else {
    Serial.println("[WiFi] AP failed.");
  }

  server.on("/", []() { server.send_P(200, "text/html", index_html); });
  server.on("/cmd", handleCmd);
  server.on("/telemetry", handleTelemetry);
  server.begin();

  delay(1000);

  BP32.setup(&onConnectedGamepad, &onDisconnectedGamepad);

  esp_task_wdt_add(NULL);

  Serial.println("=== Boot complete ===");
}

void loop() {
  // ----------------------------------------------------------------
  // Housekeeping
  // ----------------------------------------------------------------
  BP32.update();
  esp_task_wdt_reset();
  server.handleClient();
  esp_task_wdt_reset();
  processGPS();
  esp_task_wdt_reset();
  updateGyroCache();
  esp_task_wdt_reset();

  // ----------------------------------------------------------------
  // Serial console
  // ----------------------------------------------------------------
  if (Serial.available()) {
    String command = Serial.readStringUntil('\n');
    command.trim();

    if (command.equalsIgnoreCase("RESET")) {
      Serial.println("Restarting ESP32...");
      ESP.restart();
    } else if (command.equalsIgnoreCase("GYRO")) {
      gyroEnabled = !gyroEnabled;
      Serial.print("[GYRO] Yaw assist: "); Serial.println(gyroEnabled ? "ON" : "OFF");
    } else if (command.equalsIgnoreCase("FLIP")) {
      flipAssistEnabled = !flipAssistEnabled;
      Serial.print("[FLIP] Assist: "); Serial.println(flipAssistEnabled ? "ON" : "OFF");
    } else if (command.startsWith("GAIN=")) {
      float g = command.substring(5).toFloat();
      if (g > 0.0f && g < 1.0f) { gyroGain = g; Serial.print("[GYRO] Gain="); Serial.println(gyroGain); }
    } else {
      Serial.println("Received: " + command);
    }
  }

  unsigned long now = millis();
  bool connected = (myGamepad && myGamepad->isConnected());

  // ================================================================
  // FAILSAFE / RETURN-TO-HOME
  // FIX #1 — only arm the failsafe if a gamepad has EVER been connected.
  //          Otherwise the car starts driving itself 1.5 s after boot.
  // ================================================================
  if (!connected) {
    bool shouldReturn = gamepadEverConnected &&
                        (now - lastGamepadTime > FAILSAFE_TIMEOUT);

    if (shouldReturn) {
      isReturningHome = true;
      navigateHome();
      currentThrottle += (targetThrottle - currentThrottle) * FAILSAFE_THROTTLE_LERP;

      currentSteer += (targetSteer - currentSteer) * steerLerp;
      steeringServo.write((int)currentSteer);

      if (!failsafePrinted) {
        Serial.println("[FS] Failsafe / GPS RTH active");
        failsafePrinted = true;
      }
      int escSignal = constrain(1500 + (int)currentThrottle, 1000, 2000);
      esc.writeMicroseconds(escSignal);

    } else {
      // Pre-connection or pre-timeout idle: hold neutral, steer centred
      targetThrottle  = 0;
      currentThrottle = 0;
      targetSteer     = steerCenter();
      currentSteer    = steerCenter();
      esc.writeMicroseconds(1500);
      steeringServo.write(steerCenter());
    }

    updateGamepadLed(now);
    return;
  }

  if (failsafePrinted) failsafePrinted = false;

  // ================================================================
  // GAMEPAD PROCESSING
  // ================================================================
  processGamepad(myGamepad, now);
  lastGamepadTime = now;

  // ================================================================
  // BATTERY MONITORING + LVC
  // ================================================================
  float rawVoltageSample = 0;
  for (int i = 0; i < 10; i++) rawVoltageSample += analogRead(BATTERY_PIN);
  rawVoltageSample /= 10.0f;
  voltage = rawVoltageSample * (3.3f / 4095.0f) * BATTERY_DIVIDER;

  if (voltage < LVC_FLASH_TRIGGER && !flashTriggered) {
    lowBattFlashActive = true;
    flashTriggered = true;
  }

  if (voltage < LVC_SOFT_CUT) targetThrottle = (int)(targetThrottle * 0.5f);
  if (voltage < LVC_HARD_CUT) targetThrottle = 0;

  if (voltage <= LVC_FLASH_TRIGGER) {
    lowBattFlashActive = true;
  } else if (voltage > LVC_SOFT_CUT) {
    lowBattFlashActive = false;
    flashTriggered = false;
    flashCount = 0;
  }
  if (!lowBattFlashActive) flashCount = 0;

  // ================================================================
  // OUTPUT EXECUTION
  // ================================================================
  currentSteer += (targetSteer - currentSteer) * steerLerp;
  steeringServo.write((int)currentSteer);

  airAdjust = constrain(airAdjust, AIR_ADJUST_MIN, AIR_ADJUST_MAX);
  targetThrottle = constrain(targetThrottle + airAdjust, -400, POWER_BEAST_MAX);

  float lerpRate = (currentMode == MODE_BEAST) ? THROTTLE_LERP_BEAST
                                                : THROTTLE_LERP_PRECISION;
  currentThrottle += (targetThrottle - currentThrottle) * lerpRate;

  int escSignal = constrain(1500 + (int)currentThrottle, 1000, 2000);
  esc.writeMicroseconds(escSignal);

  digitalWrite(BRAKE_LIGHT_PIN, (escState == ESC_BRAKE || escState == ESC_REVERSE));

  updateGamepadLed(now);
  esp_task_wdt_reset();
}
