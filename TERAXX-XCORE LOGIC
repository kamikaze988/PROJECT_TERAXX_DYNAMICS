void processGPS() {
  int limit = 0;
  while (gpsSerial.available() > 0 && limit < 64) {
    gps.encode(gpsSerial.read());
    limit++;
  }
  if (gps.location.isValid() && !homeSet) {
    homeLat = gps.location.lat();
    homeLon = gps.location.lng();
    homeSet = true;
  }
}

void navigateHome() {
  if (!homeSet || !gps.location.isValid()) {
    targetThrottle = 0;
    return;
  }
  double dist = gps.distanceBetween(gps.location.lat(), gps.location.lng(), homeLat, homeLon);
  if (dist > 2.0) {
    double course = gps.courseTo(gps.location.lat(), gps.location.lng(), homeLat, homeLon);
    int center = 90 + steerTrim;
    double headingDeg = gps.course.deg();
    double error = course - headingDeg;

    if (error > 180) error -= 360;
    if (error < -180) error += 360;

    targetSteer = constrain(center + error * 0.7, center - steerSens, center + steerSens);
    targetThrottle = 150;
  } else {
    targetThrottle = 0;
    isReturningHome = false;
  }
}

void handleCmd() {
  String c = server.arg("c"),
         steer = server.arg("steer"),
         sens = server.arg("sens"),
         trim = server.arg("trim");
  String modeArg = server.arg("mode"),
         driftArg = server.arg("drift");
  String haloArg = server.arg("halo");
  String roofArg = server.arg("roof");

  if (modeArg == "toggle") {
    currentMode = (currentMode == MODE_BEAST) ? MODE_PRECISION : MODE_BEAST;
    digitalWrite(MODE_LED, currentMode == MODE_BEAST);
  }
  if (driftArg == "toggle") driftState = !driftState;
  if (sens != "") steerSens = sens.toInt();
  if (trim != "") steerTrim = trim.toInt();
  if (haloArg != "") {
    haloState = haloArg.toInt();
    digitalWrite(HALO_PIN, haloState);
  }
  if (roofArg != "") {
    roofState = roofArg.toInt();
    digitalWrite(ROOF_PIN, roofState);
  }
  if (steer != "") {
    int center = 90 + steerTrim;
    targetSteer = map(steer.toInt(), -100, 100, center - steerSens, center + steerSens);
  }

  if (c == "throttle") targetThrottle = (currentMode == MODE_BEAST) ? 600 : 300;
  if (c == "reverse") targetThrottle = -300;
  if (c == "stop") {
    targetThrottle = 0;
    wheelieState = false;
  }
  if (c == "boost") targetThrottle = POWER_BOOST;
  if (c == "wheelie") {
    wheelieState = true;
    wheelieStartTime = millis();
  }

  server.send(200, "text/plain", "OK");
}

void handleTelemetry() {
  lastControlTime = millis();
  JsonDocument doc;
  doc["speed"] = (int)currentThrottle;
  doc["mode"] = (currentMode == MODE_BEAST) ? "BEAST" : "PRECISION";
  doc["batt"] = (analogRead(BATTERY_PIN) * (3.3 / 4095.0) * 4.7);
  doc["drift"] = driftState;
  if (gps.location.isValid()) {
    doc["heading"] = gps.course.deg();
  }
  if (homeSet) {
    doc["relX"] = (gps.location.lng() - homeLon) * 100000;
    doc["relY"] = (homeLat - gps.location.lat()) * 100000;
  } else {
    doc["relX"] = 0;
    doc["relY"] = 0;
  }

  String json;
  serializeJson(doc, json);
  server.send(200, "application/json", json);
}

void onConnectedGamepad(GamepadPtr gp) {
  Serial.println("Gamepad Connected!");
  myGamepad = gp;
}

void onDisconnectedGamepad(GamepadPtr gp) {
  myGamepad = nullptr;
}

void updateGamepadLed(unsigned long now) {
  if (!myGamepad) return;

  if (lowBattFlashActive) {
    if (now - lastFlashTime >= FLASH_INTERVAL) {
      if (flashCount % 2 == 0) {
        myGamepad->setColorLED(255, 0, 0);  // RED
      } else {
        myGamepad->setColorLED(0, 0, 0);  // OFF
      }
      flashCount++;
      lastFlashTime = now;
    }
    return;
  }

  if (currentMode != lastLedMode) {
    if (currentMode == MODE_BEAST)
      myGamepad->setColorLED(255, 0, 0);
    else
      myGamepad->setColorLED(0, 255, 0);

    lastLedMode = currentMode;
  }
}

void updateServoSmooth() {
  if (millis() - lastServoUpdate < servoInterval) return;
  lastServoUpdate = millis();

  if (currentAngle < targetAngle) currentAngle += servoSpeed;
  else if (currentAngle > targetAngle) currentAngle -= servoSpeed;

  airBrake.write(currentAngle);
}

int processTiltSteering(int ax) {
  // convert ESP32 accel range to -1.0 ~ 1.0
  float tilt = ax / 512.0;
  // DEADZONE
  if (abs(tilt) < tiltDeadzone) {
    tilt = 0;
  }
  // remove deadzone gap
  if (tilt > 0) {
    tilt =
      (tilt - tiltDeadzone) / (1.0 - tiltDeadzone);
  } else if (tilt < 0) {
    tilt =
      (tilt + tiltDeadzone) / (1.0 - tiltDeadzone);
  }
  // sensitivity adjustment
  tilt *= steeringSensitivity;
  // limit
  tilt =
    constrain(tilt, -1.0, 1.0);
  return map(tilt * 100, -100, 100, steerCenter() - sLimit, steerCenter() + sLimit);
}
void processGamepad(ControllerPtr myGamepad) {
  // 1. Check if the PS button is currently held down
  // In Bluepad32, the PS button maps to bit 0x01 of miscButtons
  bool psButtonPressed = (myGamepad->miscButtons() & 0x01);

  // Keep track of the button state and timing across loops
  static uint32_t psButtonPressStartTime = 0;
  static bool wasPsPressed = false;

  if (psButtonPressed) {
    if (!wasPsPressed) {
      // Record the exact millisecond the user started pressing the button
      psButtonPressStartTime = millis();
      wasPsPressed = true;
      Serial.println("PS button detected. Holding for countdown...");
    }
    // Check if the button has been held down for 5000ms (5 seconds)
    else if (millis() - psButtonPressStartTime >= 5000) {
      Serial.println("5 seconds reached! Initiating soft shutdown.");
      // Turn off player LEDs and stop any vibration
      myGamepad->setPlayerLEDs(0);
      myGamepad->playDualRumble(0, 0, 0, 0);
      // Sever the link so the gamepad drops into sleep mode
      myGamepad->disconnect();
      // Reset our trackers
      wasPsPressed = false;
      return;
    }
  } else {
    // If they let go before 5 seconds, reset the timer completely
    wasPsPressed = false;
  }
}
//////////////////////////////////////////////////////////
// SETUP & LOOP
//////////////////////////////////////////////////////////

void setup() {
  Serial.begin(115200);
  Serial.println("Bluetooth ready...");
  gpsSerial.begin(9600, SERIAL_8N1, GPS_RX_PIN, GPS_TX_PIN);
  esc.attach(ESC_PIN);
  steeringServo.attach(SERVO_PIN);
  airBrake.attach(servoPin);
  airBrake.write(SPOILER_FLAT);
  pinMode(HALO_PIN, OUTPUT);
  pinMode(ROOF_PIN, OUTPUT);
  pinMode(BRAKE_LIGHT_PIN, OUTPUT);
  pinMode(MODE_LED, OUTPUT);

  WiFi.disconnect(true);
  WiFi.mode(WIFI_OFF);
  delay(500);

  WiFi.mode(WIFI_AP);
  delay(300);

  IPAddress local_IP(192, 168, 4, 1);
  IPAddress gateway(192, 168, 4, 1);
  IPAddress subnet(255, 255, 255, 0);
  WiFi.softAPConfig(local_IP, gateway, subnet);

  bool apStarted = WiFi.softAP("TERAXX_X-CORE", "123456789", 6, 0, 8);

  if (apStarted) {
    Serial.println("AP Started Successfully!");
    Serial.print("Hotspot IP Address: 192.198.4.1 ");
    Serial.println(WiFi.softAPIP());
  } else {
    Serial.println("AP Failed");
  }

  server.on("/", []() {
    server.send_P(200, "text/html", index_html);
  });
  server.on("/cmd", handleCmd);
  server.on("/telemetry", handleTelemetry);
  server.begin();

  delay(1000);

  BP32.setup(&onConnectedGamepad, &onDisconnectedGamepad);
  esp_task_wdt_init(5, true);
  esp_task_wdt_add(NULL);
}

void loop() {
  BP32.update();
  esp_task_wdt_reset();

  server.handleClient();
  esp_task_wdt_reset();

  processGPS();
  esp_task_wdt_reset();

 if (Serial.available()) {
    String command = Serial.readStringUntil('
');
    command.trim(); // Remove newline or spaces

    if (command.equalsIgnoreCase("RESET")) {
      Serial.println("Restarting ESP32...");
      ESP.restart(); // Perform software reset
    } else {
      Serial.println("Received: " + command);
    }
  }

  unsigned long now = millis();
  bool connected = (myGamepad && myGamepad->isConnected());


  if (!connected) {
    if (now - lastGamepadTime > FAILSAFE_TIMEOUT) {
      isReturningHome = true;
      navigateHome();
      currentThrottle += (targetThrottle - currentThrottle) * 0.08f;
      if (!failsafePrinted) {
        Serial.println("failsafe/GPS(RTH) active");
        failsafePrinted = true;
      }
      int escSignal = constrain(1500 + (int)currentThrottle, 1000, 2000);
      esc.writeMicroseconds(escSignal);
    } else {
      targetThrottle = 0;
      currentThrottle = 0;

      targetSteer = steerCenter();
      currentSteer = steerCenter();
      esc.writeMicroseconds(1500);
    }
    updateGamepadLed(now);
    failsafePrinted = false;
    return;
  }

  // R1 DRIVE MODE TOGGLE
  if (myGamepad->r1() && !r1Last) {
    if (now - lastR1Press < 300) {
      currentMode = (currentMode == MODE_BEAST) ? MODE_PRECISION : MODE_BEAST;
      digitalWrite(MODE_LED, currentMode == MODE_BEAST);
      Serial.println("beast/precision mode toggled");
    }
    lastR1Press = now;
  }
  r1Last = myGamepad->r1();

  // L1 Tilt Toggle
  if (myGamepad->l1() && !l1Last) {
    tiltMode = !tiltMode;
    Serial.print("tilt mode changes to: ");
    Serial.println(tiltMode);
  }
  l1Last = myGamepad->l1();

  // Roof Lights
  if (myGamepad->y() && !yLast) {
    Serial.println("roof light toggled");
    roofState = !roofState;
    digitalWrite(ROOF_PIN, roofState);
  }
  yLast = myGamepad->y();

  // HALO LIGHT AND BOOST
  bool xNow = myGamepad->x();
  if (xNow && !xLast) {
    xPressTime = now;
  }
  if (xNow && (now - xPressTime > HOLD_TIME)) {
    boostActive = true;
  }
  if (!xNow && xLast) {
    if (now - xPressTime < TAP_TIME) {
      haloState = !haloState;
      digitalWrite(HALO_PIN, haloState);
      Serial.println("headlight toggled");
    }
    boostActive = false;
  }
  xLast = xNow;

  // Drift State (B button)
  driftState = myGamepad->b();
  int center = 90 + steerTrim;
  int sLimit = driftState ? (steerSens / 2) : steerSens;

  /// D-pad steering sensitivity///////
  uint8_t dpad = myGamepad->dpad();
  static uint8_t lastDpad = 0;
  if (dpad != lastDpad) {
    if (dpad == DPAD_UP) {
      steeringSensitivity += 0.1;

      if (steeringSensitivity > maxSensitivity)
        steeringSensitivity = maxSensitivity;

      Serial.print("Steering sensitivity: ");
      Serial.println(steeringSensitivity);
    }
    if (dpad == DPAD_DOWN) {
      steeringSensitivity -= 0.1;

      if (steeringSensitivity < minSensitivity)
        steeringSensitivity = minSensitivity;

      Serial.print("Steering sensitivity: ");
      Serial.println(steeringSensitivity);
    }
  }
  lastDpad = dpad;

  // ==========================
  // STEERING CONTROLS
  // ==========================
  if (tiltMode) {
    int ax = myGamepad->accelX();
    targetSteer = processTiltSteering(ax);
  } else {
    int sx = myGamepad->axisX();
    if (abs(sx) > 60) {
      targetSteer = map(sx, -512, 512, steerCenter() - sLimit, steerCenter() + sLimit);
    } else {
      currentSteer += (center - currentSteer) * 0.2;
    }
  }

  // Throttle and Reverse inputs (r2 & l2)
  int r2 = myGamepad->r2();
  int l2 = myGamepad->l2();
  int throttleInput = 0;

  if (r2 > 100) {
    throttleInput = map(r2, 0, 1023, 0, (currentMode == MODE_BEAST) ? POWER_BEAST_MAX : POWER_PRECISION);
  } else if (l2 > 100) {
    throttleInput = -map(l2, 0, 1023, 0, 250);
  }

  // ===== ESC STATE MACHINE =====
  switch (escState) {
    case ESC_NEUTRAL:
      if (throttleInput > 0) escState = ESC_FORWARD;
      else if (throttleInput < 0) {
        escState = ESC_BRAKE;
        lastBrakeTime = millis();
      }
      break;
    case ESC_FORWARD:
      if (throttleInput < 0) {
        escState = ESC_BRAKE;
        lastBrakeTime = millis();
      }
      break;
    case ESC_BRAKE:
      if (millis() - lastBrakeTime > BRAKE_DELAY) {
        if (throttleInput < 0) escState = ESC_REVERSE;
        else if (throttleInput == 0) escState = ESC_NEUTRAL;
      }
      break;
    case ESC_REVERSE:
      if (throttleInput > 0) escState = ESC_FORWARD;
      break;
  }

  // ===== APPLY OUTPUT =====
  switch (escState) {
    case ESC_FORWARD: targetThrottle = throttleInput; break;
    case ESC_BRAKE: targetThrottle = -250; break;
    case ESC_REVERSE: targetThrottle = throttleInput; break;
    case ESC_NEUTRAL:
    default: targetThrottle = 0; break;
  }

  // Mid-Air Control (Right Analog Vertical)
  int ry = myGamepad->axisRY();
  int DEADZONE = 140;

  if (currentMode == MODE_BEAST) {
    bool noOtherInputs = abs(myGamepad->axisX()) < 60 && myGamepad->r2() < 20 && myGamepad->l2() < 20 && !myGamepad->a() && !myGamepad->b() && !myGamepad->x() && !myGamepad->y() && !myGamepad->l1() && !myGamepad->r1();

    if (abs(ry) > DEADZONE && noOtherInputs) {
      if (ry > 0) {
        targetThrottle += map(ry, DEADZONE, 512, -100, -450);
      } else {
        targetThrottle += map(ry, -512, -DEADZONE, 600, 200);
      }
      airAdjust = map(ry, -512, 512, -150, 150);
    } else {
      airAdjust *= 0.8;
      if (abs(airAdjust) < 2) airAdjust = 0;
    }
  }

  // BOOST Adjustment
  if (boostActive) {
    if (targetThrottle < POWER_BOOST) targetThrottle = POWER_BOOST;
  }
  if (driftState && targetThrottle > 0) {
    targetThrottle = max(targetThrottle, 300);
  }

  // WHEELIE BURST (Hold A)
  bool aNow = myGamepad->a();
  if (aNow) {
    if (padWheelieTime == 0) padWheelieTime = now;
    unsigned long elapsed = now - padWheelieTime;
    if (elapsed < 250) targetThrottle = POWER_WHEELIE;
    else targetThrottle = POWER_PRECISION;
  } else {
    padWheelieTime = 0;
  }

  if (wheelieState) {
    if (now - wheelieStartTime < 250) targetThrottle = 850;
    else if (now - wheelieStartTime < 1000) targetThrottle = 430;
    else wheelieState = false;
  }

  // Battery Voltage Read Loop
  float rawVoltageSample = 0;
  for (int i = 0; i < 10; i++) {
    rawVoltageSample += analogRead(BATTERY_PIN);
  }
  rawVoltageSample /= 10.0;
  voltage = rawVoltageSample * (3.3 / 4095.0) * 4.7;

  if (voltage < 6.8 && !flashTriggered) {
    lowBattFlashActive = true;
    flashTriggered = true;
  }

  // LVC Protections
  if (voltage < 7.0) targetThrottle *= 0.5;
  if (voltage < 6.4) targetThrottle = 0;

  if (voltage <= 6.8) {
    lowBattFlashActive = true;
  } else if (voltage > 7.0) {
    lowBattFlashActive = false;
    flashTriggered = false;
    flashCount = 0;
  }
  if (!lowBattFlashActive) {
    flashCount = 0;
  }

  targetAngle = SPOILER_FLAT;

  if (currentMode == MODE_BEAST) {
    if (BackFlip) targetAngle = 45;
    else if (FrontFlip) targetAngle = 30;
    else if (escState == ESC_BRAKE) targetAngle = 90;
    else if (boostActive) targetAngle = 10;
    else if (driftState) targetAngle = 15;
  }

  // Output Execution Section
  currentSteer += (targetSteer - currentSteer) * 0.2f;
  steeringServo.write((int)currentSteer);

  airAdjust = constrain(airAdjust, -120, 120);
  targetThrottle = constrain(targetThrottle + airAdjust, -400, POWER_BEAST_MAX);

  currentThrottle += (targetThrottle - currentThrottle) * ((currentMode == MODE_BEAST) ? 0.15f : 0.05f);

  int escSignal = constrain(1500 + (int)currentThrottle, 1000, 2000);
  esc.writeMicroseconds(escSignal);

  digitalWrite(BRAKE_LIGHT_PIN, (escState == ESC_BRAKE || escState == ESC_REVERSE));

  updateServoSmooth();
  updateGamepadLed(now);
  esp_task_wdt_reset();
}
